variable "instance" {
  type = map (string)
default = {
  server1 = "t3.micro"
  server2 = "t3.small"
  server3 = "t3.medium"
  SERVER = "t3.small"
}
}

resource "aws_instance" "ec3" {
  for_each = var.instance
  ami = "ami-0aba19e56f3eaec05"
  instance_type = each.value

  tags = {
    Name = each.key
  }
}